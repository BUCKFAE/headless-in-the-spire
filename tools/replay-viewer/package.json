{
  "name": "@sts2-headless/replay-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Static web viewer for headless-in-the-spire replays — reads manifest.json + .mcr.timeline.json files emitted by Sts2Headless.Replay (AD-8 / Phase A.1).",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.10.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
