<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Description>Headless host: loads sts2.dll out-of-game, exposes the wire protocol over stdio.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Diagnostic / generator CLI commands. The exe drives them only through
         the public CliCommands dispatch table; the command classes themselves
         are internal to that package. -->
    <ProjectReference Include="..\Sts2Headless.Commands\Sts2Headless.Commands.csproj" />
    <ProjectReference Include="..\Sts2Headless.Cheats\Sts2Headless.Cheats.csproj" />
    <ProjectReference Include="..\Sts2Headless.Protocol\Sts2Headless.Protocol.csproj" />
    <!-- Replay substrate (AD-8): host wires the recorder into run/new
         when STS2_REPLAY_OUT is set, and the manifest is flushed on the
         RunManager.CleanUp prefix the Replay hook installs. -->
    <ProjectReference Include="..\Sts2Headless.Replay\Sts2Headless.Replay.csproj" />
    <ProjectReference Include="..\Sts2Headless.Runtime\Sts2Headless.Runtime.csproj" />
    <!-- Shared repo/vendor paths + GAME_VERSION pin (host ping, bootstrap). -->
    <ProjectReference Include="..\Sts2Headless.Utils\Sts2Headless.Utils.csproj" />
    <!-- GodotStubs builds as GodotSharp.dll and lands next to our exe, so the
         default loader probing path satisfies sts2.dll's GodotSharp references
         without going through our vendor resolver. -->
    <ProjectReference Include="..\GodotStubs\GodotStubs.csproj" />
  </ItemGroup>

</Project>
