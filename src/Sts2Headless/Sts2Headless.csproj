<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Description>Headless host: loads sts2.dll out-of-game, exposes the wire protocol over stdio.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sts2Headless.Protocol\Sts2Headless.Protocol.csproj" />
    <!-- GodotStubs builds as GodotSharp.dll and lands next to our exe, so the
         default loader probing path satisfies sts2.dll's GodotSharp references
         without going through our vendor resolver. -->
    <ProjectReference Include="..\GodotStubs\GodotStubs.csproj" />
  </ItemGroup>

</Project>
