<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Wire protocol types: JSON-RPC-style envelope, methods, notifications. See AD-2.</Description>
    <!--
      CS8509: switch expression does not handle all possible inputs.
      Promoted to an error so the Character-exhaustiveness check in
      CharacterExtensions.Sts2TypeName fails the build the moment a
      new enum value is added without a corresponding case. The
      runtime CharacterEnumCoverageTests in Sts2Headless.UnitTests is
      the safety net behind it.
    -->
    <WarningsAsErrors>$(WarningsAsErrors);CS8509</WarningsAsErrors>
  </PropertyGroup>

  <!--
    Per-kind stub vs. generated enum.

    For each content kind (Card / Relic / Potion / Monster / Encounter /
    Event / Power / Affliction / Modifier / Enchantment / Orb), the
    Methods/ folder contains two files:

      * {Kind}Id.g.cs        — full enum + wire-name lookup, emitted by
                                `just generate-content-ids` from the
                                proprietary vendor/sts2.dll. Gitignored.
      * {Kind}Id.Fallback.cs — committed Unknown-only stub so the project
                                builds on a fresh clone (or on CI without
                                vendor/) before the generator has run.

    The conditional <Compile Remove> below excludes the fallback when its
    paired generated file exists, so the two definitions never collide.
    Anyone running `just setup` ends up compiling against the generated
    enum; anyone running `dotnet build` standalone (e.g. before vendor/
    is populated) compiles against the stub.
  -->
  <ItemGroup Condition="Exists('Methods/CardId.g.cs')">         <Compile Remove="Methods/CardId.Fallback.cs" /> </ItemGroup>
  <ItemGroup Condition="Exists('Methods/RelicId.g.cs')">        <Compile Remove="Methods/RelicId.Fallback.cs" /> </ItemGroup>
  <ItemGroup Condition="Exists('Methods/PotionId.g.cs')">       <Compile Remove="Methods/PotionId.Fallback.cs" /> </ItemGroup>
  <ItemGroup Condition="Exists('Methods/MonsterId.g.cs')">      <Compile Remove="Methods/MonsterId.Fallback.cs" /> </ItemGroup>
  <ItemGroup Condition="Exists('Methods/EncounterId.g.cs')">    <Compile Remove="Methods/EncounterId.Fallback.cs" /> </ItemGroup>
  <ItemGroup Condition="Exists('Methods/EventId.g.cs')">        <Compile Remove="Methods/EventId.Fallback.cs" /> </ItemGroup>
  <ItemGroup Condition="Exists('Methods/PowerId.g.cs')">        <Compile Remove="Methods/PowerId.Fallback.cs" /> </ItemGroup>
  <ItemGroup Condition="Exists('Methods/AfflictionId.g.cs')">   <Compile Remove="Methods/AfflictionId.Fallback.cs" /> </ItemGroup>
  <ItemGroup Condition="Exists('Methods/ModifierId.g.cs')">     <Compile Remove="Methods/ModifierId.Fallback.cs" /> </ItemGroup>
  <ItemGroup Condition="Exists('Methods/EnchantmentId.g.cs')">  <Compile Remove="Methods/EnchantmentId.Fallback.cs" /> </ItemGroup>
  <ItemGroup Condition="Exists('Methods/OrbId.g.cs')">          <Compile Remove="Methods/OrbId.Fallback.cs" /> </ItemGroup>

</Project>
