<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Description>Emits protocol/openrpc.json from Sts2Headless.Protocol records. See AD-5.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sts2Headless.Protocol\Sts2Headless.Protocol.csproj" />
    <!-- AD-7: cheat (debug/*) catalog entries are physically separated from
         Protocol so the Agents project can't see them. The schema export
         merges Core + cheats so protocol/openrpc.json describes the full
         wire surface. -->
    <ProjectReference Include="..\Sts2Headless.Cheats\Sts2Headless.Cheats.csproj" />
    <!-- Same separation logic for the content/* surface — physically
         separate project, merged into the emitted schema here. -->
    <ProjectReference Include="..\Sts2Headless.Content\Sts2Headless.Content.csproj" />
    <!-- GAME_VERSION pin parsing for the schema's version stamp. -->
    <ProjectReference Include="..\Sts2Headless.Utils\Sts2Headless.Utils.csproj" />
  </ItemGroup>

</Project>
