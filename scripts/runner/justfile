import '../common.just'

# See scripts/setup/justfile for why this `set` is per-module.
set working-directory := '../..'

# Diagnostic probes / type & member lookups against a loaded sts2.dll.
mod probe 'probe/justfile'

# Run the headless host (prints the banner and vendor inventory for now).
run:
    @just build::build
    @dotnet run --project src/Sts2Headless/Sts2Headless.csproj --no-build

# Run the host in NDJSON stdio mode (AD-2). One JSON request per line
# on stdin, one response per line on stdout.
stdio:
    @just build::build
    @dotnet run --project src/Sts2Headless/Sts2Headless.csproj --no-build -- --stdio

# Run the headless-in-the-spire MCP server over stdio
# (clients/python/headless-in-the-spire-mcp). Adds the server to any
# MCP-aware AI (Claude Desktop / Claude Code / etc.). Pass
# `--enable-debug` to expose AD-7 debug tools — never use in production.
run-mcp *args:
    @bash scripts/setup/check-uv.sh
    @uv run --frozen headless-in-the-spire-mcp {{args}}

# Run the replay viewer's Vite dev server (tools/replay-viewer). Opens
# an HMR-enabled frontend that loads replays from replays/ (default root).
dev-viewer:
    @bash scripts/setup/check-pnpm.sh
    @cd tools/replay-viewer && pnpm run dev

# Drive every Python agent (greedy, random, block, attack) in parallel
# and record into replays/manual/ (the default replay root; the manifest
# stamps the agent name). Each worker spawns its own host subprocess
# (and its own sts2.dll), so default --workers is conservative. Forward
# extra flags after `--`, e.g.
# `just runner::record-all -- --seeds 1 2 3 --workers 8`.
record-all *args:
    @just build::build
    @uv run --frozen python -m headless_in_the_spire_agents.examples.run_all_agents {{args}}

# Drive a short RandomAgent run on seed=42 with recording enabled, then
# dump the recorded directory tree (AD-8). Produces
# replays/sample/<game-version>/<run-id>/{manifest.json,
# combats/*.mcr, run.json on engine-side death/victory} plus a top-level
# runs.json the viewer reads. Useful as a smoke-test for the recording
# substrate end-to-end, and produces the demo data the replay-viewer
# tests point at.
record-sample-replay:
    @just build::build
    @rm -rf replays/sample
    @uv run --frozen python -m headless_in_the_spire_agents.examples.run_all_agents --agents random --seeds 42 --out replays/sample --max-steps 25
    @echo
    @echo "=== recorded replay ==="
    @find replays/sample -type f | sort
    @echo
    @echo "=== runs.json ==="
    @cat replays/sample/runs.json 2>/dev/null || echo "(no runs.json — recording produced nothing)"

# Hand a fresh game to Claude Code over the project's .mcp.json MCP
# server and let it drive one full STS2 run end-to-end. Streams Claude's
# reasoning + tool calls live (one line per SDK stream-json event,
# formatted via scripts/runner/format-claude-stream.jq). Replays land in
# replays/manual/<game-version>/<run-id>/ (default root) with
# STS2_REPLAY_AGENT=claude-code stamped into the manifest. Only the
# mcp__headless-in-the-spire__* tools are allowed, so Claude cannot
# touch the repo. Burns Claude API tokens; Ctrl-C to stop early.
play-claude:
    @just build::build
    @bash -c "set -o pipefail; STS2_REPLAY_AGENT=claude-code claude -p 'You are playing one full run of Slay the Spire 2 through the headless-in-the-spire MCP server. Start with run_new (pick a character and seed). Use summarize_state for cheap polls between actions; reach for run_state only when you need the full structural payload. Drive the run end-to-end: traverse the map, play cards and end turns in combat, claim or skip rewards, resolve events, rest at fires, shop at merchants. Continue until the run ends (death or victory) or you are demonstrably stuck. Do not ask for confirmation — just play.' --model sonnet --allowedTools 'mcp__headless-in-the-spire__*' --output-format stream-json --verbose | jq -r --unbuffered -f scripts/runner/format-claude-stream.jq"

# Walk replays/manual/ (or the given root) and rewrite runs.json. The
# host rebuilds it on every recorder finalize, so you only need this
# after manually copying recordings in/out of the tree.
rebuild-replay-index *root:
    @just build::build
    @dotnet run --project src/Sts2Headless/Sts2Headless.csproj --no-build -- --rebuild-replay-index {{root}}
