# Local configuration. Copy to `.env` and edit. The `.env` file is gitignored.
#
# `just` auto-loads variables from `.env` (see `set dotenv-load` in justfile).

# Absolute path to your local Slay the Spire 2 install directory.
# This is the directory that directly contains `sts2.dll`. Linux defaults:
#   ~/.steam/steam/steamapps/common/Slay the Spire 2
#   ~/.local/share/Steam/steamapps/common/Slay the Spire 2
# On a secondary Steam library:
#   /run/media/<user>/<disk>/SteamLibrary/steamapps/common/Slay the Spire 2
STS2_GAME_DIR=/path/to/Slay the Spire 2
