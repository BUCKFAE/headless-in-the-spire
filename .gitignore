
# External tools, cloned by claude
external-tools/

# Local configuration — per-machine paths, never commit.
.env

# Vendored game DLLs — extracted from each contributor's local Steam install.
# sts2.dll is proprietary and must not be checked in. We pin the version
# via GAME_VERSION (checked in) + a SHA-256 of the expected bytes.
/vendor

# Generated content-id manifests, sourced from vendor/sts2.dll's ModelDb.
# Each *.g.cs is the full enum + wire-name lookup for one content kind
# (cards / relics / potions / monsters / encounters / events / powers /
# enchantments / modifiers / afflictions / orbs). The lists themselves
# are proprietary content (same provenance as the DLL bytes they're
# derived from), so we treat them like /vendor rather than
# protocol/openrpc.json: regenerate locally via `just generate-content-ids`
# (run automatically by `just setup`).
# *.Fallback.cs (committed) supplies an Unknown-only stub so Protocol
# still compiles before the generator has produced the real enum.
/src/Sts2Headless.Protocol/*.g.cs

# ModelDb introspection dumps, written by `just probe-modeldb`. One file
# per ModelDb enumeration property + a top-level content-inventory.txt.
# Same proprietary-content rationale as the *.g.cs files above: the
# probe writes per-kind id lists derived from vendor/sts2.dll.
/documentation/research/modeldb/

# Per-run + cross-run coverage reports written by `just coverage`. Same
# proprietary-content rationale as /documentation/research/modeldb/: each
# report enumerates id sets observed against the manifest universe, so
# the on-disk markdown/json carries a derivative of vendor/sts2.dll's
# proprietary content. Regenerate locally.
/documentation/coverage/

# .NET build artifacts.
bin/
obj/

# Python (uv workspace). Workspace .venv lives at the repo root; uv.lock is
# checked in for reproducible installs.
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
dist/
build/

# Node toolchain (tools/replay-viewer). pnpm-lock.yaml is checked in for
# reproducibility; node_modules and Vite's dist/ are not.
node_modules/
.vite/
.pnpm-store/
# Playwright artefacts (HTML report + per-test traces / videos / screenshots).
playwright-report/
test-results/

## IntelliJ
.idea

## MacOS
.DS_Store
