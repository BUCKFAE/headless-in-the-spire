
# External tools, cloned by claude
external-tools/

# Local configuration — per-machine paths, never commit.
.env

# Vendored game DLLs — extracted from each contributor's local Steam install.
# sts2.dll is proprietary and must not be checked in. We pin the version
# via GAME_VERSION (checked in) + a SHA-256 of the expected bytes.
/vendor

# Generated from vendor/sts2.dll's ModelDb.AllCards — a 577-name enum of
# every card the game ships. The list itself is proprietary content
# (same provenance as the DLL bytes it's derived from), so we treat it
# like /vendor rather than protocol/openrpc.json: regenerate locally
# via `just generate-card-ids` (run automatically by `just setup`).
# CardId.Fallback.cs (committed) supplies a CardId.Unknown-only stub so
# Protocol still compiles before the generator has produced the real
# enum.
/src/Sts2Headless.Protocol/CardId.g.cs

# .NET build artifacts.
bin/
obj/

# Python (uv workspace). Workspace .venv lives at the repo root; uv.lock is
# checked in for reproducible installs.
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
dist/
build/

