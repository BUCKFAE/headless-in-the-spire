<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Description>Integration tests that load vendor/sts2.dll (in-process or via subprocess). Local-only: cannot run on CI because the game DLL is proprietary and not checked in. Run `just setup` first; without it these tests fail with a clear error.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>

  <ItemGroup>
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tests construct typed Request/Response DTOs from Sts2Headless.Protocol
         so a renamed wire field is a compile error here, not a silently-
         passing test. -->
    <ProjectReference Include="..\..\src\Sts2Headless.Protocol\Sts2Headless.Protocol.csproj" />
    <ProjectReference Include="..\..\src\Sts2Headless.Runtime\Sts2Headless.Runtime.csproj" />
    <!-- Agents is used as a test driver to set up multi-room state (e.g.
         "walk forward until standing on a rest site"). Per AD-6 the agent
         is the canonical greedy driver — integration tests reuse it rather
         than duplicating the greedy logic and drifting from the e2e suite. -->
    <ProjectReference Include="..\..\src\Sts2Headless.Agents\Sts2Headless.Agents.csproj" />
    <!-- GodotStubs builds as GodotSharp.dll and must be present next to the
         test binaries so sts2.dll's references resolve. -->
    <ProjectReference Include="..\..\src\GodotStubs\GodotStubs.csproj" />
    <!-- The HostSubprocess fixture spawns Sts2Headless.dll from the test
         bin/, so this reference both lands the exe nearby and keeps it
         rebuilt when its sources change. -->
    <ProjectReference Include="..\..\src\Sts2Headless\Sts2Headless.csproj" />
  </ItemGroup>

</Project>
