<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Description>Integration tests that load vendor/sts2.dll (in-process or via subprocess). Local-only: cannot run on CI because the game DLL is proprietary and not checked in. Run `just setup` first; without it these tests fail with a clear error.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>

  <ItemGroup>
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tests construct typed Request/Response DTOs from Sts2Headless.Protocol
         so a renamed wire field is a compile error here, not a silently-
         passing test. -->
    <ProjectReference Include="..\..\src\Sts2Headless.Protocol\Sts2Headless.Protocol.csproj" />
    <!-- Replay substrate (AD-8). Loaded for the in-process .mcr
         round-trip / hook-install tests. -->
    <ProjectReference Include="..\..\src\Sts2Headless.Replay\Sts2Headless.Replay.csproj" />
    <ProjectReference Include="..\..\src\Sts2Headless.Runtime\Sts2Headless.Runtime.csproj" />
    <!-- Content-manifest tests reuse GenerateContentIdsCommand's ModelDb walk. -->
    <ProjectReference Include="..\..\src\Sts2Headless.Commands\Sts2Headless.Commands.csproj" />
    <!-- Cheat DTOs + typed ITransport extensions for tests that exercise
         the debug/* surface. Off the Agents project's reference graph so
         agents physically cannot reach cheats. -->
    <ProjectReference Include="..\..\src\Sts2Headless.Cheats\Sts2Headless.Cheats.csproj" />
    <!-- Agents is used as a test driver to set up multi-room state (e.g.
         "walk forward until standing on a rest site"). Per AD-6 the agent
         is the canonical greedy driver — integration tests reuse it rather
         than duplicating the greedy logic and drifting from the e2e suite. -->
    <ProjectReference Include="..\..\src\Sts2Headless.Agents\Sts2Headless.Agents.csproj" />
    <!-- BattleAgent.Core ships the SimStateBuilder + CombatModel we drive
         alongside the engine for parity tests (CombatParityTests). -->
    <ProjectReference Include="..\..\src\Sts2Headless.BattleAgent.Core\Sts2Headless.BattleAgent.Core.csproj" />
    <!-- BattleAgent is used by the smoke test that drives a real combat
         with SimAgent against the host. -->
    <ProjectReference Include="..\..\src\Sts2Headless.BattleAgent\Sts2Headless.BattleAgent.csproj" />
    <!-- MechanicSweep's SweepRegistry is what EveryKindHasASweepTest
         compares against GenerateContentIdsCommand.Kinds. -->
    <ProjectReference Include="..\..\src\Sts2Headless.MechanicSweep\Sts2Headless.MechanicSweep.csproj" />
    <!-- GodotStubs builds as GodotSharp.dll and must be present next to the
         test binaries so sts2.dll's references resolve. -->
    <ProjectReference Include="..\..\src\GodotStubs\GodotStubs.csproj" />
    <!-- The HostSubprocess fixture spawns Sts2Headless.dll from the test
         bin/, so this reference both lands the exe nearby and keeps it
         rebuilt when its sources change. -->
    <ProjectReference Include="..\..\src\Sts2Headless\Sts2Headless.csproj" />
    <!-- Shared test helpers (TempDir). -->
    <ProjectReference Include="..\Sts2Headless.TestSupport\Sts2Headless.TestSupport.csproj" />
  </ItemGroup>

</Project>
