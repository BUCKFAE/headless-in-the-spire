<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Description>Unit tests that DO NOT load vendor/sts2.dll. Safe to run on CI and on any machine without a local game install. Anything that touches the live game DLL belongs in Sts2Headless.IntegrationTests instead.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" Version="7.3.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- OpenRPC meta-schema + its json-schema-tools meta dependency (AD-5).
         Embedded so the validation test runs hermetically — no network fetch
         at test time. Re-snapshot from:
           https://github.com/open-rpc/meta-schema (openrpc-meta-schema.json)
           https://meta.json-schema.tools/         (json-schema-tools-meta.json) -->
    <EmbeddedResource Include="Resources/openrpc-meta-schema.json" />
    <EmbeddedResource Include="Resources/json-schema-tools-meta.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Sts2Headless.Agents\Sts2Headless.Agents.csproj" />
    <!-- CLI dispatch table — CliCommandsTests pins its behaviour. -->
    <ProjectReference Include="..\..\src\Sts2Headless.Commands\Sts2Headless.Commands.csproj" />
    <ProjectReference Include="..\..\src\Sts2Headless.Protocol\Sts2Headless.Protocol.csproj" />
    <ProjectReference Include="..\..\src\Sts2Headless.Replay\Sts2Headless.Replay.csproj" />
    <ProjectReference Include="..\..\src\Sts2Headless.Runtime\Sts2Headless.Runtime.csproj" />
    <!-- Referenced so the AD-4 invariant test can inspect every production
         assembly that lands in the test bin/. GodotStubs comes along
         transitively via Sts2Headless. -->
    <ProjectReference Include="..\..\src\Sts2Headless\Sts2Headless.csproj" />
    <ProjectReference Include="..\..\src\GodotStubs\GodotStubs.csproj" />
    <!-- Shared test helpers (TempDir, used by SetupDirTests). -->
    <ProjectReference Include="..\Sts2Headless.TestSupport\Sts2Headless.TestSupport.csproj" />
  </ItemGroup>

</Project>
