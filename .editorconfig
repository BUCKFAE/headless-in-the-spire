root = true

[*.cs]

# Dead-code detection — these run on every `dotnet build` because
# Directory.Build.props sets <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>.
# CI build fails if any of these fire; same locally so the feedback loop matches.

# Unused using directives
dotnet_diagnostic.CS8019.severity = error
dotnet_diagnostic.IDE0005.severity = error

# Unreachable code detected
dotnet_diagnostic.CS0162.severity = error

# Unused private members / fields / locals
dotnet_diagnostic.IDE0051.severity = error
dotnet_diagnostic.IDE0052.severity = error
dotnet_diagnostic.CA1823.severity = error
dotnet_diagnostic.IDE0059.severity = error

# Variable assigned but value never used
dotnet_diagnostic.CS0219.severity = error
